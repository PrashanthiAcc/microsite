{
  "openapi": "3.0.3",
  "info": {
    "title": "Industry-X Manufacturing Lab Microsite API",
    "description": "REST API for managing Industries, Sub-Industries, Value Chains, and Use Cases in the Manufacturing Lab Microsite.",
    "version": "1.0.0",
    "contact": {
      "name": "Industry-X Manufacturing Lab"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "security": [
    {
      "userRoleHeader": []
    }
  ],
  "tags": [
    {
      "name": "Industry",
      "description": "Industry, Sub-Industry, Value Chain and aggregated microsite data endpoints"
    },
    {
      "name": "Sub-Industry",
      "description": "Sub-Industry lookup endpoints"
    },
    {
      "name": "Value Chain",
      "description": "Value Chain lookup and filter endpoints"
    },
    {
      "name": "Use Case",
      "description": "Use Case CRUD operations"
    }
  ],
  "paths": {
    "/industry/v1/industries": {
      "get": {
        "tags": ["Industry"],
        "summary": "Get all industries",
        "description": "Retrieves a list of all industries.",
        "operationId": "getAllIndustries",
        "responses": {
          "200": {
            "description": "Successfully retrieved list of industries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Industry" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/industry/v1/sub-industries": {
      "get": {
        "tags": ["Sub-Industry"],
        "summary": "Get all sub-industries",
        "description": "Retrieves a list of all sub-industries.",
        "operationId": "getAllSubIndustries",
        "responses": {
          "200": {
            "description": "Successfully retrieved list of sub-industries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/SubIndustry" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/industry/v1/industries/{industryId}/sub-industries": {
      "get": {
        "tags": ["Sub-Industry"],
        "summary": "Get sub-industries by industry ID",
        "description": "Retrieves a list of sub-industries for a given industry.",
        "operationId": "getSubIndustriesByIndustryId",
        "parameters": [
          {
            "name": "industryId",
            "in": "path",
            "required": true,
            "description": "The industry ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved sub-industries for the given industry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/SubIndustry" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/industry/v1/value-chains": {
      "get": {
        "tags": ["Value Chain"],
        "summary": "Get all value chains",
        "description": "Retrieves a list of all value chains.",
        "operationId": "getAllValueChains",
        "responses": {
          "200": {
            "description": "Successfully retrieved list of value chains",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ValueChainDTO" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/industry/v1/value-chains/filter": {
      "get": {
        "tags": ["Value Chain"],
        "summary": "Get value chains by filter",
        "description": "Retrieves value chains filtered by industry ID and/or sub-industry ID.",
        "operationId": "getValueChainsByFilter",
        "parameters": [
          {
            "name": "industryId",
            "in": "query",
            "required": false,
            "description": "Filter by industry ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "subIndustryId",
            "in": "query",
            "required": false,
            "description": "Filter by sub-industry ID",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved filtered value chains",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/ValueChainDTO" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/industry/v1/all/data": {
      "get": {
        "tags": ["Industry"],
        "summary": "Get all microsite data",
        "description": "Retrieves aggregated microsite data including all industries, sub-industries, and value chains in a single response.",
        "operationId": "getAllIndustryData",
        "responses": {
          "200": {
            "description": "Successfully retrieved aggregated microsite data",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MicrositeDataDTO" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/usecase/v1/create": {
      "post": {
        "tags": ["Use Case"],
        "summary": "Create a new use case",
        "description": "Creates a new use case with the provided details.",
        "operationId": "createUseCase",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UseCaseRequestDTO" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Use case created successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UseCaseResponseDTO" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/usecase/v1/{usecaseId}": {
      "get": {
        "tags": ["Use Case"],
        "summary": "Get a use case by ID",
        "description": "Retrieves a use case by its unique identifier.",
        "operationId": "getUseCaseById",
        "parameters": [
          {
            "name": "usecaseId",
            "in": "path",
            "required": true,
            "description": "The use case ID",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved the use case",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UseCaseResponseDTO" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "put": {
        "tags": ["Use Case"],
        "summary": "Update an existing use case",
        "description": "Updates an existing use case with the provided details.",
        "operationId": "updateUseCase",
        "parameters": [
          {
            "name": "usecaseId",
            "in": "path",
            "required": true,
            "description": "The use case ID",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UseCaseRequestDTO" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Use case updated successfully",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UseCaseResponseDTO" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Use Case"],
        "summary": "Soft-delete a use case",
        "description": "Soft-deletes a use case by setting its active flag to false.",
        "operationId": "deleteUseCase",
        "parameters": [
          {
            "name": "usecaseId",
            "in": "path",
            "required": true,
            "description": "The use case ID",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Use case deleted successfully (no content)"
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/usecase/v1/all": {
      "get": {
        "tags": ["Use Case"],
        "summary": "Get all active use cases",
        "description": "Retrieves a list of all active (non-deleted) use cases.",
        "operationId": "getAllActiveUseCases",
        "responses": {
          "200": {
            "description": "Successfully retrieved list of active use cases",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/UseCaseResponseDTO" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "userRoleHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "user-role",
        "description": "Role of the authenticated user. Valid values: admin, superadmin, presenter, viewer."
      }
    },
    "parameters": {
      "UserRoleHeader": {
        "name": "user-role",
        "in": "header",
        "required": true,
        "description": "Role of the authenticated user (admin, superadmin, presenter, viewer)",
        "schema": {
          "type": "string",
          "enum": ["admin", "superadmin", "presenter", "viewer"]
        }
      }
    },
    "schemas": {
      "Industry": {
        "type": "object",
        "properties": {
          "industryId": {
            "type": "integer",
            "format": "int64",
            "description": "Unique identifier for the industry"
          },
          "industryName": {
            "type": "string",
            "maxLength": 255,
            "description": "Name of the industry"
          }
        }
      },
      "SubIndustry": {
        "type": "object",
        "properties": {
          "subIndustryId": {
            "type": "integer",
            "format": "int64",
            "description": "Unique identifier for the sub-industry"
          },
          "subIndustryName": {
            "type": "string",
            "maxLength": 255,
            "description": "Name of the sub-industry"
          },
          "industryId": {
            "type": "integer",
            "format": "int64",
            "description": "ID of the parent industry"
          }
        }
      },
      "ValueChainDTO": {
        "type": "object",
        "properties": {
          "valueChainId": {
            "type": "integer",
            "format": "int64",
            "description": "Unique identifier for the value chain"
          },
          "valueChainName": {
            "type": "string",
            "maxLength": 255,
            "description": "Name of the value chain"
          },
          "industryId": {
            "type": "integer",
            "format": "int64",
            "description": "ID of the associated industry"
          },
          "subIndustryId": {
            "type": "integer",
            "format": "int64",
            "description": "ID of the associated sub-industry"
          }
        }
      },
      "IndustryDTO": {
        "type": "object",
        "properties": {
          "industryId": {
            "type": "integer",
            "format": "int64"
          },
          "industryName": {
            "type": "string"
          }
        }
      },
      "SubIndustryDTO": {
        "type": "object",
        "properties": {
          "subIndustryId": {
            "type": "integer",
            "format": "int64"
          },
          "subIndustryName": {
            "type": "string"
          },
          "industryId": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "MicrositeDataDTO": {
        "type": "object",
        "properties": {
          "industries": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/IndustryDTO" }
          },
          "subIndustries": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SubIndustryDTO" }
          },
          "valueChains": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ValueChainDTO" }
          }
        }
      },
      "UseCaseRequestDTO": {
        "type": "object",
        "required": ["industryId", "subIndustryId", "valueChainId", "title", "ownerId"],
        "properties": {
          "industryId": {
            "type": "integer",
            "format": "int64",
            "description": "Industry ID"
          },
          "subIndustryId": {
            "type": "integer",
            "format": "int64",
            "description": "Sub-Industry ID"
          },
          "valueChainId": {
            "type": "integer",
            "format": "int32",
            "description": "Value Chain ID"
          },
          "title": {
            "type": "string",
            "maxLength": 255,
            "description": "Title of the use case"
          },
          "thumbnailImageUrl": {
            "type": "string",
            "maxLength": 500,
            "description": "URL for thumbnail image"
          },
          "tag": {
            "type": "string",
            "maxLength": 100,
            "description": "Tag for the use case"
          },
          "description": {
            "type": "string",
            "description": "Detailed description"
          },
          "duration": {
            "type": "integer",
            "format": "int32",
            "description": "Duration in minutes"
          },
          "ownerId": {
            "type": "integer",
            "format": "int32",
            "description": "Owner user ID"
          },
          "primarySpeakerEid": {
            "type": "string",
            "maxLength": 100,
            "description": "Primary speaker enterprise ID"
          },
          "secondarySpeakerEid": {
            "type": "string",
            "maxLength": 100,
            "description": "Secondary speaker enterprise ID"
          },
          "tertiarySpeakerEid": {
            "type": "string",
            "maxLength": 100,
            "description": "Tertiary speaker enterprise ID"
          },
          "oneSliderUrl": {
            "type": "string",
            "maxLength": 500,
            "description": "URL for one-slider artifact"
          },
          "multiSliderUrl": {
            "type": "string",
            "maxLength": 500,
            "description": "URL for multi-slider artifact"
          },
          "demoVideoUrl": {
            "type": "string",
            "maxLength": 500,
            "description": "URL for demo video"
          },
          "clientTestimonialDemoUrl": {
            "type": "string",
            "maxLength": 500,
            "description": "URL for client testimonial demo"
          },
          "narrationVideoUrl": {
            "type": "string",
            "maxLength": 500,
            "description": "URL for narration video"
          },
          "businessProblem": {
            "type": "string",
            "description": "Business problem statement"
          },
          "solutions": {
            "type": "string",
            "description": "Solutions provided"
          },
          "valueDelivered": {
            "type": "string",
            "description": "Value delivered to the client"
          },
          "toolsAndTechnologies": {
            "type": "string",
            "description": "Tools and technologies used"
          },
          "keyResults": {
            "type": "string",
            "description": "Key results achieved"
          },
          "status": {
            "type": "string",
            "maxLength": 20,
            "description": "Status of the use case",
            "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "ARCHIVED"]
          },
          "approverId": {
            "type": "integer",
            "format": "int32",
            "description": "Approver user ID"
          },
          "isActive": {
            "type": "boolean",
            "description": "Whether the use case is active"
          },
          "creatorId": {
            "type": "integer",
            "format": "int32",
            "description": "Creator user ID"
          }
        }
      },
      "UseCaseResponseDTO": {
        "type": "object",
        "properties": {
          "usecaseId": {
            "type": "integer",
            "format": "int32",
            "description": "Unique identifier for the use case"
          },
          "industryId": {
            "type": "integer",
            "format": "int64"
          },
          "subIndustryId": {
            "type": "integer",
            "format": "int64"
          },
          "valueChainId": {
            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "thumbnailImageUrl": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "duration": {
            "type": "integer",
            "format": "int32"
          },
          "ownerId": {
            "type": "integer",
            "format": "int32"
          },
          "primarySpeakerEid": {
            "type": "string"
          },
          "secondarySpeakerEid": {
            "type": "string"
          },
          "tertiarySpeakerEid": {
            "type": "string"
          },
          "oneSliderUrl": {
            "type": "string"
          },
          "multiSliderUrl": {
            "type": "string"
          },
          "demoVideoUrl": {
            "type": "string"
          },
          "clientTestimonialDemoUrl": {
            "type": "string"
          },
          "narrationVideoUrl": {
            "type": "string"
          },
          "businessProblem": {
            "type": "string"
          },
          "solutions": {
            "type": "string"
          },
          "valueDelivered": {
            "type": "string"
          },
          "toolsAndTechnologies": {
            "type": "string"
          },
          "keyResults": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "IN_REVIEW", "APPROVED", "ARCHIVED"]
          },
          "approverId": {
            "type": "integer",
            "format": "int32"
          },
          "approvedDate": {
            "type": "string",
            "format": "date-time"
          },
          "createdDate": {
            "type": "string",
            "format": "date-time"
          },
          "updatedDate": {
            "type": "string",
            "format": "date-time"
          },
          "isActive": {
            "type": "boolean"
          },
          "creatorId": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "errorCode": {
            "type": "string",
            "description": "Application-specific error code"
          },
          "errorDescription": {
            "type": "string",
            "description": "Human-readable error description"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request - validation error or invalid input",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Unauthorized - missing or empty user-role header",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Forbidden": {
        "description": "Forbidden - invalid user-role header value",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    }
  }
}
